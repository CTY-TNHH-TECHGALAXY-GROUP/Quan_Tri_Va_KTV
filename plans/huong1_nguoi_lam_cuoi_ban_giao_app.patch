-        sg?.voided === true && (sg?.note === 'CHANGED' || sg?.note === NOTE_EARLY_LEAVE_NOT_STARTED));
+        const segs: any[] = Array.isArray(parsed) ? parsed : [];
+        for (const sg of segs) {
