+/** Voided flag, tolerating the legacy string 'true' (rows written before segments were normalized). */
+const voidedFlag = (seg: any): boolean => seg?.voided === true || seg?.voided === 'true';
+
+/**
+ * ONE rule for "does this KTV still owe the room handover of this service" — used by the counter
+ * (submitCustomerRating), the KTV app (segmentProgress → handleFinishService) and room debt /
+ * pending handovers / unfinished work (hasNoRoomDutyOnItems). Owner decision 09/10/2026
+ * ("người làm cuối cùng bàn giao phòng"), plans/plan_sua_doi_ktv_giua_ca_va_huy_dv_dang_cho.md mục 12:
+ *  - never started                                   → no
+ *  - working segment (not voided) that started       → yes
+ *  - swapped out (CHANGED) / early leave not started → no (the incoming KTV or the counter handles the room)
+ *  - started, then voided (cancelled no credit, …)   → only if NOBODY took the service further, i.e. no
+ *    other live started segment on the item (whole service cancelled). Otherwise the last worker hands
+ *    the room over (e.g. sequential: A cancelled no credit, B finishes and hands over).
+ */
+export function segmentOwesRoomHandover(seg: any, itemSegments: any[]): boolean {
+    if (!seg?.actualStartTime || !seg?.ktvId) return false;
+    if (!voidedFlag(seg)) return true;
+    if (seg.note === 'CHANGED' || seg.note === NOTE_EARLY_LEAVE_NOT_STARTED) return false;
+    return !(Array.isArray(itemSegments) ? itemSegments : [])
+        .some((other: any) => other !== seg && !voidedFlag(other) && !!other?.actualStartTime);
+}
+
 /**
